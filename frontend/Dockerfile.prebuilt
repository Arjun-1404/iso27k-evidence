# Fallback for machines that cannot download the build tools (see "If the build stops with ..." in the README).
# It does not build anything: it serves the web app that is already built in ./dist, which was built to talk to the
# API at http://localhost:3000. For any other API address use the normal Dockerfile, which builds it for you.
FROM nginx:1.27-alpine
COPY dist /usr/share/nginx/html
# A single-page app needs every path to fall back to index.html so client-side routing works on a hard refresh.
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / {\n    try_files $uri /index.html;\n  }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
